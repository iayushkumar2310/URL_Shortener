# Local PostgreSQL (docker-compose.yml)
DATABASE_URL="postgresql://snip:snip_local_dev@localhost:5432/snip?schema=public"

# Where generated links point; use your public short-link domain in production.
PUBLIC_SHORT_URL_BASE="http://localhost:3000"

# Frontend origin allowed by the API.
FRONTEND_ORIGIN="http://localhost:5173"

# Backend port
PORT=3000
